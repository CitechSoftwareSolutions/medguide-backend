# Copy to backend/.env to override defaults. Nothing is required to boot.
# The assistant needs Ollama running locally with the model pulled:
#   ollama pull medgemma1.5:4b
# Every value below is the default; uncomment a line to change it.
# Defaults live in src/shared/config.py.

# Agent model (MedGemma via Ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=medgemma1.5:4b
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_SECONDS=300
# OLLAMA_KEEP_ALIVE=30m
# AGENT_MAX_ANSWER_TOKENS=2048
# AGENT_RECURSION_LIMIT=40

# Embeddings and chunking, shared by both tools
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80
# MAX_UPLOAD_BYTES=20971520

# Tool 01: knowledge base
# KNOWLEDGE_BASE_DOCUMENTS_DIR=src/tools/tool_01_knowledge_base/data
# KNOWLEDGE_BASE_VECTOR_STORE_DIR=var/tool_01_knowledge_base
# KNOWLEDGE_BASE_TOP_K=8
# KNOWLEDGE_BASE_MIN_SCORE=0.35

# Tool 02: NICE guidance
# NICE_DOCUMENTS_DIR=src/tools/tool_02_nice_guidance/data
# NICE_VECTOR_STORE_DIR=var/tool_02_nice_guidance
# NICE_TOP_K=6
# NICE_MIN_SCORE=0.35

# Chat sessions
# SESSION_MAX_TURNS=20
# SESSION_TTL_SECONDS=3600

# Browser origins allowed to call the API (comma-separated), for a deployed frontend
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=

# Application
# APP_NAME=Medical Knowledge Base API
# ENVIRONMENT=development
