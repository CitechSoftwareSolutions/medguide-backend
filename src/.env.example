# Copy to backend/.env and fill in. Nothing is required to boot;
# ANTHROPIC_API_KEY is required for the question-answering assistant.

# Enables POST /api/v1/agent/ask. Without it that endpoint returns
# 503 agent_unavailable and the rest of the API works as normal.
ANTHROPIC_API_KEY=sk-ant-api03-replace-with-your-key

# Optional overrides; the defaults in src/config/settings.py are sensible.
# AGENT_MODEL=claude-sonnet-5
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_STORE_DIR=var/vector_store
# DOCUMENTS_DIR=src/data
# RETRIEVAL_TOP_K=8
# RETRIEVAL_MIN_SCORE=0.35
# SESSION_MAX_TURNS=20
# SESSION_TTL_SECONDS=3600
