# Copy to backend/.env to override defaults. Nothing is required to boot.
# The assistant needs Ollama running locally with the model pulled:
#   ollama pull medgemma1.5:4b

# Optional overrides; the defaults in src/config/settings.py are sensible.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=medgemma1.5:4b
# OLLAMA_NUM_CTX=8192
# OLLAMA_TIMEOUT_SECONDS=300
# EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# VECTOR_STORE_DIR=var/vector_store
# DOCUMENTS_DIR=src/data
# RETRIEVAL_TOP_K=8
# RETRIEVAL_MIN_SCORE=0.35
# SESSION_MAX_TURNS=20
# SESSION_TTL_SECONDS=3600
